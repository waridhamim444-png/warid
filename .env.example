# ==========================================
# Amazon FBA Business Analysis Assistant
# Environment Variables Configuration
# ==========================================

# GEMINI_API_KEY (Recommended):
# Google Gemini API key used for live AI strategic diagnosis, Amazon review TOS compliance audits, and advisor chat.
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# On Render: Add this under your Web Service > Environment > Environment Variables.
# Note: If not provided, the app will safely run in resilient mode using built-in certified heuristic SOP engines.
GEMINI_API_KEY=

# NODE_ENV (Automatic on Render):
# Set to 'production' for production builds.
NODE_ENV=production

# PORT (Automatic on Render):
# The port on which the Express server listens.
# Render automatically assigns this environment variable (e.g. 10000). Defaults to 3000 locally.
PORT=3000

